# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# build output
# 有意提交单文件产物 dist/index.html：
# 它是本项目的**唯一用户交付物**，提交后别人 clone / 下载即可双击使用，
# 无需安装 Node、无需构建。其余构建中间产物仍忽略。
/dist/*
!/dist/index.html
/dist-ssr/

# vite cache
.vite/

# AI agent local memory
.workbuddy/

# testing
/coverage

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# agent scratch files (临时调试/提交信息/验证产物，统统不入仓库)
.commit-msg.txt
.debug-*
.dist-out.*
.verify-*

# local environment
.env*
!.env.example

# editors
.idea/
.vscode/*
!.vscode/extensions.json
